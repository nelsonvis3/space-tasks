# Standalone backend only; npm run dev includes its own API.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
BACKUP_DIR=./backups
# Production only: public HTTPS origin; no trailing slash.
# NODE_ENV=production
# APP_ORIGIN=https://space.example
# Only behind exactly one reverse proxy that sets X-Forwarded-For (Nginx, Render...).
# Without it, every visitor shares the proxy's address for sign-in limits.
# TRUST_PROXY=1
# New accounts allowed per IP every 15 minutes (default 5).
# REGISTRATION_LIMIT=5
# Free disk space kept in reserve: below it, new accounts and PDF uploads are refused (default 2048).
# MIN_FREE_DISK_MB=2048
